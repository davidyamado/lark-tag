# Required: create a Feishu application and a PostgreSQL database, then fill
# these values in a local .env file. Never commit real credentials.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
POSTGRES_URL=postgresql://user:pass@localhost:5432/feishu_bot

# Optional Claude/API configuration. Leave blank to use local Claude OAuth or
# the client defaults.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=anthropic/claude-sonnet-4.6
CLAUDE_HOME=
OA_API_KEY=

# Optional bot configuration.
FEISHU_BOT_OPEN_ID=
BOT_EVENT_INGRESS=lark_cli
LARK_BOT_HOME=/var/lark-bot/config
LARK_USERS_DIR=/var/lark-bot/users
